node_modules/
dist/
.DS_Store

# Key material. Nothing in this repo may contain a private key.
# spike/.dev-key is a throwaway seeding identity (see spike/seed-listings.ts);
# it is gitignored, holds no funds, and is deleted when slice 4 lands a real Signer.
.env
.env.*
*.nsec
spike/.dev-key
spike/seed-photos/

# Every OTHER seller identity, and this one is a glob on purpose. Each new seller onboarded with
# `node spike/authorize-manage.ts --key <file>` mints a fresh key on disk, and the named entries
# further down this file only cover the ones that existed when they were written. A key that is
# only ignored once somebody remembers to add a line is a key that gets committed.
spike/.*-key
spike/.*-key.*

# Node credentials. admin.connect is nprofile:token = full node authority.
admin.connect
*.connect
app.nprofile

# Minted CLINK offers for the fixture sale (spike/mint-offers.ts). Node-specific state,
# regenerated by re-running that script; the noffers point at a local Lightning.Pub.
spike/.offers.json

# The pre-signed availability ladder (spike/seed-listings.ts -> spike/watch-sales.ts). Signed
# public events, no key material — but it is cut from one version of the listings and goes
# stale the moment they are re-seeded, so it is generated, never committed.
spike/.ladder.json

# The CLINK Manage pointer written by spike/authorize-manage.ts. Not key material, but TLV 2
# carries the account pointer, whose publication hands every visitor a channel to push
# authorization prompts at the seller (/docs/spec.md §6.1). Seller's browser only.
spike/.nmanage

# One-time bunker-import exports (spike/export-key-qr.ts). THESE ARE PRIVATE KEY MATERIAL.
# Written chmod 600, and meant to be deleted the moment the import is done.
spike/.dev-key.nsec
spike/.dev-key.qr.svg

# A built copy of /storefront, put here by builder/bundle-storefront.mjs so the builder can
# deploy it (slice 5). Build output of another package — regenerated by `npm run build` in
# /builder, never committed.
builder/public/site/
builder/public/site.json

# Throwaway nsite identities (slice 5). A kind 15128 root site is ONE PER PUBKEY, so the
# storefront and the builder cannot share a key — each deploy target needs its own.
# Not the seller identity, hold no funds, regenerate freely.
spike/.deploy-test-key
spike/.builder-key

# Slice 7, the refund path. NOT the seller identity and NOT the node account: .refund-key holds
# no funds and can do exactly one thing — ask the node to pay a BOLT11, up to the frequency cap
# on its grant. Still a private key, so still chmod 600 and still never committed.
# Regenerate with `node spike/authorize-refunds.ts`; revoke with `--revoke`.
spike/.refund-key

# The ndebit pointer written by spike/authorize-refunds.ts. Not key material, but TLV 2 carries
# the account pointer, same handling as spike/.nmanage (/docs/spec.md §6.1).
spike/.ndebit

# The refund journal: which oversells have been paid, keyed on the settled invoice. Local state
# by necessity — a refund is a write and the node has nowhere to record one (spike/refund.ts).
# It records the KIND of each buyer's pointer and never the pointer itself. Machine-specific,
# and losing it means a paid refund could be paid twice, so back it up rather than commit it.
spike/.refunds.json
spike/.refunds.json.tmp

# Demo screenshots. Regenerate with `cd shots && npm run capture` — they are shot at 2–3x and
# come to ~30 MB, and every one of them is reproducible from the built apps and the live relays.
# The PDF they compose into IS committed: it is the submission artifact, and it is 3.8 MB.
shots/out/
