node_modules/
dist/
.DS_Store

# Key material. Nothing in this repo may contain a private key.
# spike/.dev-key is a throwaway seeding identity (see spike/seed-listings.ts);
# it is gitignored, holds no funds, and is deleted when slice 4 lands a real Signer.
.env
.env.*
*.nsec
spike/.dev-key
spike/seed-photos/

# Node credentials. admin.connect is nprofile:token = full node authority.
admin.connect
*.connect
app.nprofile

# Minted CLINK offers for the fixture sale (spike/mint-offers.ts). Node-specific state,
# regenerated by re-running that script; the noffers point at a local Lightning.Pub.
spike/.offers.json

# The pre-signed availability ladder (spike/seed-listings.ts -> spike/watch-sales.ts). Signed
# public events, no key material — but it is cut from one version of the listings and goes
# stale the moment they are re-seeded, so it is generated, never committed.
spike/.ladder.json

# The CLINK Manage pointer written by spike/authorize-manage.ts. Not key material, but TLV 2
# carries the account pointer, whose publication hands every visitor a channel to push
# authorization prompts at the seller (/docs/spec.md §6.1). Seller's browser only.
spike/.nmanage

# One-time bunker-import exports (spike/export-key-qr.ts). THESE ARE PRIVATE KEY MATERIAL.
# Written chmod 600, and meant to be deleted the moment the import is done.
spike/.dev-key.nsec
spike/.dev-key.qr.svg

# A built copy of /storefront, put here by builder/bundle-storefront.mjs so the builder can
# deploy it (slice 5). Build output of another package — regenerated by `npm run build` in
# /builder, never committed.
builder/public/site/
builder/public/site.json

# Throwaway nsite identities (slice 5). A kind 15128 root site is ONE PER PUBKEY, so the
# storefront and the builder cannot share a key — each deploy target needs its own.
# Not the seller identity, hold no funds, regenerate freely.
spike/.deploy-test-key
spike/.builder-key
